<section class="reviews-section" id="reviews">
  <div class="reviews-header">
    <h2>What customers say</h2>
    <div class="reviews-rating">
      <span class="big-num">4.9</span>
      <span class="stars">★★★★★</span>
      <span class="count">Based on 240+ reviews</span>
    </div>
  </div>
  <div class="reviews-grid">
    <div class="review-card">
      <div class="review-stars">★★★★★</div>
      <p class="review-text">"This is genuinely one of the best purchases I've made this year. My recovery after the gym has completely changed."</p>
      <div class="review-author">Marcus T.</div>
      <div class="review-verified">Verified buyer</div>
    </div>
    <div class="review-card">
      <div class="review-stars">★★★★★</div>
      <p class="review-text">"Shipped faster than expected, product is exactly as described. Already ordered two more as gifts for my brothers."</p>
      <div class="review-author">Jada R.</div>
      <div class="review-verified">Verified buyer</div>
    </div>
    <div class="review-card">
      <div class="review-stars">★★★★★</div>
      <p class="review-text">"I was skeptical at first but this thing actually works. My skin has noticeably improved in just 2 weeks of using it."</p>
      <div class="review-author">Devon K.</div>
      <div class="review-verified">Verified buyer</div>
    </div>
  </div>
</section>

{% schema %}
{ "name": "Reviews", "presets": [{"name":"Reviews"}] }
{% endschema %}
