<footer>
  <div class="footer-top">
    <div>
      <div class="footer-logo">{{ settings.logo_text | default: 'Curasuix' }}</div>
      <p class="footer-tagline">Premium self care and wellness products for people who take themselves seriously.</p>
    </div>
    <div class="footer-links">
      <h5>Shop</h5>
      <a href="/collections/face-care">Face Care</a>
      <a href="/collections/skin-care">Skin Care</a>
      <a href="/collections/hair-care">Hair Care</a>
      <a href="/collections/fitness-body">Fitness & Body</a>
    </div>
    <div class="footer-links">
      <h5>Help</h5>
      <a href="/pages/faq">FAQ</a>
      <a href="/pages/contact">Contact Us</a>
      <a href="/policies/shipping-policy">Shipping Policy</a>
      <a href="/policies/refund-policy">Returns</a>
    </div>
    <div class="footer-links">
      <h5>Company</h5>
      <a href="/pages/about">About Us</a>
      <a href="/policies/privacy-policy">Privacy Policy</a>
      <a href="/policies/terms-of-service">Terms of Service</a>
    </div>
  </div>
  <div class="footer-bottom">
    <div class="footer-copy">© {{ 'now' | date: '%Y' }} {{ shop.name }}. All rights reserved.</div>
    <div class="footer-copy">Made for people who take themselves seriously.</div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    { "type": "text", "id": "logo_text", "label": "Logo text", "default": "Curasuix" }
  ],
  "presets": [{"name":"Footer"}]
}
{% endschema %}
