<section class="cart-section">
  <h2>Your cart</h2>

  {% if cart.item_count == 0 %}
    <p>Your cart is empty.</p>
  {% else %}
    <form action="/cart" method="post" novalidate>
      <table style="width:100%;border-collapse:collapse;color:#fff">
        <thead>
          <tr>
            <th>Product</th>
            <th>Qty</th>
            <th>Price</th>
          </tr>
        </thead>
        <tbody>
          {% for item in cart.items %}
            <tr>
              <td>{{ item.product.title }}{% if item.variant.title != 'Default Title' %} — {{ item.variant.title }}{% endif %}</td>
              <td><input type="number" name="updates[{{ item.key }}]" value="{{ item.quantity }}" min="0" style="width:64px"></td>
              <td>{{ item.final_line_price | money }}</td>
            </tr>
          {% endfor %}
        </tbody>
      </table>

      <div style="margin-top:20px">
        <button type="submit" class="btn-primary">Update cart</button>
        <a href="/checkout" class="btn-secondary" style="margin-left:12px">Checkout</a>
      </div>
    </form>
  {% endif %}
</section>

{% schema %}
{ "name": "Cart", "presets": [{"name":"Cart"}] }
{% endschema %}
