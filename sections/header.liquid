      <span>Handpicked quality products</span>
    </div>
  </div>

  <nav>
    <div class="logo">{{ settings.logo_text | default: 'Curasuix' }}</div>
    <div class="nav-links">
      <a href="/collections/all">Shop</a>
      <a href="/collections">Collections</a>
