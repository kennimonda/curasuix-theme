<section class="collection-list">
  <div class="section-label">Shop by collection</div>
  <div class="collections-grid">
    {% if section.blocks.size > 0 %}
      {% for block in section.blocks %}
        {% if block.settings.collection != blank %}
          {% assign c = collections[block.settings.collection] %}
          {% if c %}
            <a class="collection-card" href="{{ c.url }}">
              <span class="collection-icon">{{ block.settings.icon | default: '✨' }}</span>
              <div class="collection-name">{{ c.title }}</div>
              <div class="collection-count">{{ c.products_count }} products</div>
            </a>
          {% endif %}
        {% endif %}
      {% endfor %}
    {% else %}
      <!-- Fallback to some default links -->
      <a class="collection-card" href="/collections/all">
        <span class="collection-icon">✨</span>
        <div class="collection-name">All products</div>
        <div class="collection-count">View store</div>
      </a>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Collections teaser",
  "settings": [],
  "blocks": [
    {
      "type": "collection_block",
      "name": "Collection",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "icon", "label": "Icon (emoji or text)", "default": "✨" }
      ]
    }
  ],
  "presets": [{"name":"Collections"}]
}
{% endschema %}
